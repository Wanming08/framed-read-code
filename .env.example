# scripts/dev-up.sh generates a private .env with random infrastructure secrets.
# SILICONFLOW_API_KEY may remain empty for health, login, uploads and playback.
SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
# Python uses DB_USERNAME/DB_PASSWORD and these host defaults only when run
# outside Compose; Compose overrides the host to mysql:3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=media_db
MYSQL_ROOT_PASSWORD=change-root-password
# Set a real SiliconFlow key, then rerun scripts/dev-up.sh to start the worker.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR
ASR_URL=https://api.siliconflow.cn/v1/audio/transcriptions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
# Browser-accessible host used when signing playback URLs from containers.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
FFMPEG_DIR=
OCR_COMMAND=tesseract
# Python 5.x SDK connects to the Broker's gRPC Proxy, not NameServer.
# Run API/worker in this Compose network: the SDK follows the Proxy's
# advertised container address, which macOS hosts cannot reach directly.
ROCKETMQ_ENDPOINTS=rmqbroker:8081
ROCKETMQ_ANALYSIS_TOPIC=video-analysis-topic
ROCKETMQ_ANALYSIS_DEAD_TOPIC=video-analysis-dead-topic
ROCKETMQ_ANALYSIS_GROUP=video-analysis-consumer
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
